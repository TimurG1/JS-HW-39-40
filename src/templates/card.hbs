<article class="user-card">
    <h1 class="user-card__name">
      {{names.common}}
    </h1>
    <p class="user-card__email">
     Capital:{{capitals.0.name}}
    </p>  
    <p class="user-card__population">
     Population: {{population}}
    </p>
    <ul>
      Language:
      {{#each languages}}
       <li>{{name}}</li>
      {{/each}}
    </ul>
    <img src={{flag.url_png}} alt="" width="400">
</article>